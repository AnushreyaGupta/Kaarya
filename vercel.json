{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "server/index.ts", "use": "@vercel/node" },
    { "src": "package.json", "use": "@vercel/vite" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server/index.ts" },
    { "src": "/health", "dest": "server/index.ts" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
